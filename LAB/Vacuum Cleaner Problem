# 0 = Dirty, 1 = Clean

A = int(input("Enter status of Room A (0=Dirty, 1=Clean): "))
B = int(input("Enter status of Room B (0=Dirty, 1=Clean): "))

position = input("Enter vacuum position (A/B): ").upper()

while A == 0 or B == 0:

    if position == "A":
        if A == 0:
            print("Room A is dirty. Cleaning Room A.")
            A = 1
        else:
            print("Room A is clean. Moving to Room B.")
            position = "B"

    elif position == "B":
        if B == 0:
            print("Room B is dirty. Cleaning Room B.")
            B = 1
        else:
            print("Room B is clean. Moving to Room A.")
            position = "A"

print("Both rooms are clean.")
